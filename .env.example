# --- API server ---
API_PORT=8787
WEB_ORIGIN=http://localhost:5173

# --- Database (matches docker-compose) ---
DATABASE_URL=postgres://awb:awb@localhost:5433/awb

# --- Temporal (matches docker-compose) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=awb-workflows

# --- LLM compiler ---
# stub  = return a canned graph, no API calls, no spend (good for UI/engine work)
# claude = call the Anthropic API (requires ANTHROPIC_API_KEY)
COMPILER_MODE=stub
ANTHROPIC_API_KEY=
COMPILER_MODEL=claude-sonnet-5

# During a dry run, LLM nodes return a deterministic mock instead of calling out.
# Set to "live" to actually invoke the model for llm nodes in dry runs.
DRY_RUN_LLM=mock

# --- Secure Hub (credential vault) ---
# Any string works in dev; use 32 random bytes (base64 or hex) in production.
SECRET_KEY=dev-insecure-secret-key-change-me
# Shared token the worker uses to fetch decrypted connection secrets from the API.
INTERNAL_TOKEN=dev-internal-token
# Base URL used to build the webhook listener URLs shown in the UI.
PUBLIC_URL=http://localhost:8787

# --- Worker → API (connection resolution) ---
AWB_API_URL=http://localhost:8787

# --- Slack (fallback when a slack_post node has no connection set) ---
SLACK_BOT_TOKEN=
