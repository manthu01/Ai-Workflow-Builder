# Public demo settings for docker-compose.prod.yml. Copy to .env.prod on the
# server and fill in the secrets. Never commit .env.prod.

DEMO_MODE=true
# Public URL of the demo (cookie Secure flag, webhook URLs) and the UI origin.
PUBLIC_URL=https://workflows.example.com
WEB_ORIGIN=https://workflows.example.com

# Secrets: generate each with `openssl rand -base64 32`.
POSTGRES_PASSWORD=
SECRET_KEY=
INTERNAL_TOKEN=
LOCAL_RUNNER_TOKEN=

# Compiler. "stub" is the offline rule-based compiler: no API key, no spend.
# "claude" needs ANTHROPIC_API_KEY; set a monthly spend limit on that key in
# the Anthropic console before going live.
COMPILER_MODE=stub
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5
MODEL_BALANCED=claude-sonnet-5
MODEL_DEEP=claude-opus-5
DRY_RUN_LLM=mock

# Demo limits (defaults shown).
DEMO_COMPILES_PER_HOUR=5
DEMO_COMPILES_PER_DAY=200
DEMO_PROMPT_MAX_CHARS=1000
DEMO_RETENTION_HOURS=24
DEMO_REPO_URL=https://github.com/manthu01/Ai-Workflow-Builder

# Knowledge bases: local in-process models (downloaded once into the models volume).
EMBEDDINGS_MODE=local
EMBEDDING_DIMENSIONS=384
RERANK_MODE=local

TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=awb-workflows
API_PORT=8787
